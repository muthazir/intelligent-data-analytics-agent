# ============================================================================
# IDAA — environment configuration
# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is already in .gitignore — never commit real credentials.
# ============================================================================

# ---------------------------------------------------------------------------
# SQL Server connection (Phase 1)
# ---------------------------------------------------------------------------
# Pick ONE of the two formats below depending on how your SQL Server login
# is configured. Replace SQLEXPRESS with your actual instance name if
# different (check SSMS "Connect to Server" dialog — Server name field).
#
# Windows Authentication (trusted connection) — most common for a local
# SSMS/Express install on a personal laptop:
DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/IDAA_DB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# SQL Server login (username + password) — use this instead if you created
# a SQL login rather than using Windows Authentication:
# DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@localhost\SQLEXPRESS/IDAA_DB?driver=ODBC+Driver+17+for+SQL+Server

# If DATABASE_URL is left unset/blank, the backend automatically falls back
# to file-only mode (exactly like before Phase 1) — nothing crashes, but
# nothing gets persisted to SQL Server either.

# ---------------------------------------------------------------------------
# Gemini (optional — safe to leave blank; narration then falls back to a
# deterministic narration built from the computed facts, labelled as such,
# and the app still runs and persists everything else normally)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional: override the Gemini model ID (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=
